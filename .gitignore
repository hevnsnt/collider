# Build directories
build/
build-*/
build_*/
cmake-build-*/
out/

# Local build helper output and ad-hoc batch files
build_*_out.txt
do_build_*.bat
# Underscore-prefixed scratch helpers + logs at repo root.
# These are throwaway scripts used during iterative development and
# must never reach the public Free repo.
/_*.bat
/_*.log
/*.pot

# IDE files
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# Compiled objects
*.o
*.obj
*.a
*.lib
*.so
*.dylib
*.dll

# Executables
*.exe
superflayer
collider
thepuzzler
thecollider

# CUDA compiled
*.cubin
*.fatbin
*.ptx

# CMake generated
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
compile_commands.json

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
venv/
.env

# Data files (too large for git)
data/passwords/rockyou.txt
data/passwords/darkc0de.txt
data/wordlists/frequency_words.txt
data/wordlists/wikipedia_frequency.txt
data/wordlists/german.txt
data/names/xato_usernames.txt
processed/*.txt

# Keep structure but ignore large processed files
!processed/rules/
!processed/stats.json

# Logs
*.log
logs/

# Temporary files
*.tmp
*.temp
tmp/
temp/

# Test outputs
test_results/
benchmark_results/

# Generated output files (puzzle solutions, findings)
puzzle_found.txt
puzzle_solved.txt
*_found.txt
*_solved.txt
findings/
solutions/

# Bloom filter files
*.blf
*.bloom

# State/checkpoint files
*.state
*.checkpoint
checkpoints/

# Claude Code / AI assistant files
.claude/

# vcpkg (auto-downloaded during build)
vcpkg/

# User config (contains personal pool URLs, wallet addresses, local paths)
config.yml
config.yaml

# Temporary build/test scripts and outputs from dev sessions
_tmp_*.bat
_build_*_out*.txt
bash_test.txt
build_out.txt
do_build.bat
run_build.bat
run_build.ps1
ksp_direct.txt
run_ksp_direct.bat
brainwallet.pot
brainwallet_hits.txt
utxodump.csv

# v1.4.2: local build helper batch files (not for repo)
/_*.bat
/_rc.log
/_v142_*.log
/build_log.txt
/build2/
/keys/
/.review_tmp/

# v1.4.2-quality: throwaway scratchpads must be ignored at ANY depth, not
# only the repo root. The root-only patterns above miss helpers dropped
# into scripts/ or tools/ during iterative review work. These any-depth
# patterns catch them everywhere.
_*.bat
_*.txt
_*.py
_*.log

# Review-process artifacts (free-form report files dropped at repo root
# or under any subdir during a review pass).
findings.txt
findings*.txt
found-empty.txt

# Throwaway build wrappers used during iterative builds. Distinct from
# the build_*_out.txt logs above (those are output captures); these are
# the wrapper scripts themselves.
build_repair.bat
build_runner_only.bat

# Per-tier review build wrappers (scripts/tier3_*.bat etc). The free
# repo never sees these; they exist only on the pro side for batched
# review reruns.
scripts/tier*_*.bat
scripts/tier*_*_*.bat

# Compute-sanitizer artifacts. scripts/run_compute_sanitizer.bat writes
# both a text report (stdout + stderr capture) and a binary trace file
# alongside the build. They can hit hundreds of MB on a real run; never
# belong in git. Glob covers both .txt and .bin under any cwd.
sanitizer_report.*
build_test_pro.bat
build_ctest_pro.bat
ctest_log.txt
build_log.txt
